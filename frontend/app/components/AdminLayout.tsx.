"use client";


import {
  Layout,
  Menu,
  Avatar,
  Dropdown,
  Breadcrumb
} from "antd";


import {
  DashboardOutlined,
  ApiOutlined,
  RobotOutlined,
  UserOutlined,
  TeamOutlined,
  GiftOutlined,
  SettingOutlined,
  LogoutOutlined,
  MenuFoldOutlined,
  MenuUnfoldOutlined
} from "@ant-design/icons";


import {
  usePathname,
  useRouter
} from "next/navigation";


import {
  useState
} from "react";


import AuthGuard from "./AuthGuard";



const {
  Header,
  Sider,
  Content
}=Layout;





const modules:any={


dashboard:{

title:"数据中心",

path:"/",

children:[

{
key:"/",
label:"数据首页"
},

{
key:"/statistics",
label:"数据统计"
}

]

},



ai:{

title:"AI中心",

path:"/ai",

children:[

{
key:"/ai",
label:"接口配置"
},

{
key:"/ai/proxy",
label:"网络出口"
},

{
key:"/ai/personality",
label:"AI角色"
},

{
key:"/ai/statistics",
label:"调用统计"
}

]

},




wechat:{

title:"微信机器人",

path:"/wechat",

children:[

{
key:"/wechat",
label:"机器人账号"
},

{
key:"/groups",
label:"群管理"
}

]

},





users:{

title:"用户中心",

path:"/users",

children:[

{
key:"/users",
label:"用户管理"
}

]

},





shop:{

title:"商业中心",

path:"/shop",

children:[

{
key:"/shop",
label:"商城管理"
}

]

},





settings:{

title:"系统设置",

path:"/settings",

children:[

{
key:"/settings",
label:"系统设置"
}

]

}


};





export default function AdminLayout({

children

}:{

children:React.ReactNode

}){


const router=useRouter();

const pathname=usePathname();


const [collapsed,setCollapsed]=useState(false);



const logout=()=>{


localStorage.removeItem(
"token"
);


router.replace(
"/login"
);


};





const currentModule =

Object.values(modules)

.find(
(m:any)=>
pathname.startsWith(m.path)
)


||modules.dashboard;





const leftMenus =

currentModule.children.map(

(item:any)=>(

{

key:item.key,

label:item.label

}

)

);






return (

<AuthGuard>


<Layout

style={{

minHeight:"100vh"

}}

>



<Sider

theme="dark"

width={230}

collapsed={collapsed}

>


<div

style={{

height:64,

display:"flex",

alignItems:"center",

justifyContent:"center",

color:"#fff",

fontSize:18,

fontWeight:"bold"

}}

>

🐌 蜗牛群聊精灵

</div>



<Menu

theme="dark"

mode="inline"

selectedKeys={[pathname]}

items={leftMenus}

onClick={(e)=>router.push(e.key)}

/>



</Sider>





<Layout>



<Header

style={{

background:"#fff",

display:"flex",

alignItems:"center",

padding:"0 20px",

gap:30

}}

>



<div

style={{

fontSize:20,

cursor:"pointer"

}}

onClick={()=>setCollapsed(!collapsed)}

>

{

collapsed

?

<MenuUnfoldOutlined/>

:

<MenuFoldOutlined/>

}

</div>





{

Object.keys(modules).map(

(key)=>(


<div

key={key}

style={{

cursor:"pointer",

fontWeight:

currentModule===modules[key]

?

700

:

400

}}

onClick={()=>{


router.push(
modules[key].path
);


}}

>

{

modules[key].title

}

</div>


)

)

}





<div

style={{

marginLeft:"auto"

}}

>


<Dropdown

menu={{

items:[

{

key:"logout",

label:"退出登录",

icon:<LogoutOutlined/>,

onClick:logout

}

]

}}

>

<Avatar

icon={<UserOutlined/>}

/>

</Dropdown>


</div>



</Header>






<Content

style={{

padding:20

}}

>



<Breadcrumb

items={[

{

title:"蜗牛群聊精灵"

},

{

title:currentModule.title

}

]}

/>




<div

style={{

marginTop:20,

background:"#fff",

padding:20,

borderRadius:8

}}

>


{children}


</div>



</Content>



</Layout>



</Layout>


</AuthGuard>

);


}
